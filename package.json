{
  "name": "hallmark-reception",
  "productName": "Hallmark Residences HRMS",
  "version": "1.0.0",
  "description": "Hallmark Residence Management System",
  "author": "Henry Bruno",
  "main": "electron/main.js",

  "scripts": {
    "electron": "electron .",
    "build": "npm --prefix frontend run build",
    "dist": "npm run build && electron-builder"
  },

  "build": {
    "appId": "com.hallmark.hrms",
    "productName": "Hallmark Residences HRMS",

    "directories": {
      "output": "release"
    },

    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "assets/**/*",
      "package.json"
    ],

    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hallmark Residences HRMS"
    }
  },

  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}